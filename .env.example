# Multi-Tenant Booking Platform - Environment Configuration
# 
# IMPORTANT: This file contains template values only.
# NEVER commit actual secrets or credentials.
# Copy this file to .env and fill in your actual values.

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================

# Application name
APP_NAME=Multi-Tenant Booking Platform

# Environment: development, staging, production
NODE_ENV=development

# Application port
PORT=3000

# Application URL (for callbacks, webhooks, etc.)
APP_URL=http://localhost:3000

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# PostgreSQL connection string for Supabase
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/booking_platform

# Direct connection string (without connection pooling)
DATABASE_DIRECT_URL=postgresql://postgres:yourpassword@localhost:5432/booking_platform

# ===========================================
# AUTHENTICATION - CLERK
# ===========================================

# Clerk Secret Key (from Clerk Dashboard)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Clerk Publishable Key (for frontend)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Clerk Webhook Secret (for verifying webhook requests)
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret

# Clerk JWT Key (for verifying tokens)
CLERK_JWT_KEY=your_clerk_jwt_key

# ===========================================
# PAYMENTS - STRIPE
# ===========================================

# Stripe Secret Key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe Publishable Key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe Webhook Secret
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Stripe Connect - Platform Account ID
STRIPE_ACCOUNT_ID=acct_your_stripe_account_id

# ===========================================
# EMAIL CONFIGURATION
# ===========================================

# Email provider: 'resend' or 'postmark'
EMAIL_PROVIDER=resend

# Resend API Key (if using Resend)
RESEND_API_KEY=re_your_resend_api_key

# Postmark Server Token (if using Postmark)
POSTMARK_SERVER_TOKEN=your_postmark_server_token

# Default sender email
EMAIL_FROM=bookings@yourdomain.com

# Default sender name
EMAIL_FROM_NAME=Booking Platform

# ===========================================
# BACKGROUND JOBS
# ===========================================

# Inngest/Trigger.dev configuration
# INNGEST_SIGNING_KEY=your_inngest_signing_key
# INNGEST_EVENT_KEY=your_inngest_event_key

# ===========================================
# REDIS / CACHING
# ===========================================

# Redis connection URL for caching and rate limiting
REDIS_URL=redis://localhost:6379

# ===========================================
# LOGGING & OBSERVABILITY
# ===========================================

# Sentry DSN for error monitoring
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@sentry.io/your_project

# Sentry environment
SENTRY_ENVIRONMENT=development

# Log level: debug, info, warn, error
LOG_LEVEL=debug

# ===========================================
# BOOKING CONFIGURATION
# ===========================================

# Default booking horizon in days
DEFAULT_BOOKING_HORIZON_DAYS=60

# Default minimum notice in minutes
DEFAULT_MINIMUM_NOTICE_MINUTES=60

# Default cancellation notice in minutes
DEFAULT_CANCELLATION_NOTICE_MINUTES=1440

# Default slot increment in minutes
DEFAULT_SLOT_INCREMENT_MINUTES=15

# Maximum booking horizon in days (platform limit)
MAX_BOOKING_HORIZON_DAYS=180

# ===========================================
# SECURITY CONFIGURATION
# ===========================================

# Session secret for cookies
SESSION_SECRET=your_secure_session_secret_at_least_32_chars

# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Management token expiration in hours
MANAGEMENT_TOKEN_EXPIRY_HOURS=24

# Hold expiration in minutes
BOOKING_HOLD_EXPIRY_MINUTES=15

# ===========================================
# PLATFORM ADMIN
# ===========================================

# Platform admin user IDs (comma-separated)
PLATFORM_ADMIN_USER_IDS=user_1,user_2

# ===========================================
# DEMO / SEED DATA
# ===========================================

# Enable seed data on startup (development only)
SEED_DEMO_DATA=false

# Demo business count to create
DEMO_BUSINESS_COUNT=2

# ===========================================
# FEATURE FLAGS
# ===========================================

# Enable Stripe Connect for payments
ENABLE_STRIPE_CONNECT=false

# Enable subscription billing
ENABLE_SUBSCRIPTIONS=false

# Enable SMS notifications (future)
ENABLE_SMS_NOTIFICATIONS=false

# Enable Google Calendar sync (future)
ENABLE_CALENDAR_SYNC=false

# Enable website templates (future)
ENABLE_WEBSITE_TEMPLATES=false